# 中国移动 XR30（NAND 版）= CMCC RAX3000M 孪生机型；ImmortalWrt 无 XR30 独立设备定义。
# 原则：只声明偏离上游默认的项，其余全部依赖默认值与依赖推导。

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_cmcc_rax3000m=y

# 性能：BBR 拥塞控制（默认 cubic）
CONFIG_PACKAGE_kmod-tcp-bbr=y

# 内存：256MB 设备的 ZRAM 压缩交换；启用 zstd 编译后端（默认仅 lzo 系）
CONFIG_PACKAGE_zram-swap=y
CONFIG_KERNEL_ZRAM_BACKEND_ZSTD=y

# 代理：HomeProxy / sing-box
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_luci-i18n-homeproxy-zh-cn=y

# UI：Argon（默认 bootstrap）
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# 工具
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_curl=y
