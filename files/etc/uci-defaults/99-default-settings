#!/bin/sh
# 首次开机执行一次。只保留设备级的通用决策；
# Wi-Fi（信道/频宽/SSID）、主题等个人项依赖上游默认，开机后在 LuCI 自行设置。

# 硬件 NAT 卸载（mt7981 PPE + WED；上游默认关闭）
uci set firewall.@defaults[0].flow_offloading='1'
uci set firewall.@defaults[0].flow_offloading_hw='1'
uci commit firewall

# 主机名；ZRAM 压缩算法 zstd（init 脚本默认强制 lzo）
uci set system.@system[0].hostname='XR30'
uci set system.@system[0].zram_comp_algo='zstd'
uci commit system

# BBR（默认 cubic）
printf 'net.ipv4.tcp_congestion_control = bbr\n' > /etc/sysctl.d/99-bbr.conf
